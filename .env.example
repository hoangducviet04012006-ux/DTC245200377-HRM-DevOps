# Database Configuration (PostgreSQL)
POSTGRES_DB=hrm_db
POSTGRES_USER=hrm_user
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_PORT=5432

# pgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=admin@hrm.com
PGADMIN_DEFAULT_PASSWORD=your_pgadmin_password_here
PGADMIN_PORT=5050

# Application Configuration
APP_PORT=3000
NODE_ENV=production

# Admin Initial Credentials (Stored securely outside Git in .env)
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=your_strong_admin_password_here
ADMIN_FORCE_PASSWORD_SYNC=false
